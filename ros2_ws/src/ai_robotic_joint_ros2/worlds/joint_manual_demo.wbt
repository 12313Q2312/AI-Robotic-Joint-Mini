#VRML_SIM R2025a utf8
# UI verification fixture, NOT the final SolidWorks CAD design.
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
WorldInfo { basicTimeStep 16 }
Viewpoint { orientation -0.3500837 0.3643763 0.8629434 1.6779899 position -0.0187 -0.61895 0.66688 }
TexturedBackground { }
TexturedBackgroundLight { }
Solid {
  translation 0 0 -0.015
  children [ Shape { appearance PBRAppearance { baseColor 0.15 0.19 0.24 roughness 1 } geometry DEF FLOOR Box { size 2 2 0.02 } } ]
  boundingObject USE FLOOR
}
Robot {
  translation 0 0 0.02
  children [
    Shape { appearance PBRAppearance { baseColor 0.15 0.45 0.8 roughness 0.6 } geometry DEF BASE Box { size 0.12 0.12 0.04 } }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 0.02 minStop -1.5708 maxStop 1.5708 dampingConstant 0.02 }
      device [ RotationalMotor { name "joint_motor" maxTorque 0.1 } PositionSensor { name "joint_sensor" } ]
      endPoint Solid {
        translation 0.07 0 0.02
        children [
          Shape { appearance PBRAppearance { baseColor 0.85 0.25 0.15 roughness 0.7 } geometry DEF LINK Box { size 0.14 0.04 0.04 } }
          Transform { translation 0.105 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.95 0.55 0.08 roughness 0.6 } geometry DEF LOAD Box { size 0.05 0.05 0.06 } } ] }
        ]
        name "output_link"
        boundingObject Group { children [ Box { size 0.14 0.04 0.04 } Transform { translation 0.105 0 0 children [ Box { size 0.05 0.05 0.06 } ] } ] }
        physics Physics { density -1 mass 1.2 }
      }
    }
  ]
  name "joint_manual_demo"
  boundingObject USE BASE
  controller "<extern>"
}
