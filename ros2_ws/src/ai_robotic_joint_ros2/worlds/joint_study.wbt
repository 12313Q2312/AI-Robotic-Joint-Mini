#VRML_SIM R2025a utf8
# Synthetic paired horizontal-axis fixture, NOT SolidWorks-imported final CAD.
# Both arms use identical motor limits, mechanical stops and a shared controller.
EXTERNPROTO "../resource/StudyCamGeometry.proto"
WorldInfo { basicTimeStep 16 }
Viewpoint { orientation 0.1546 0.9472 0.2810 2.386 position 0.60 -0.96 0.68 }
Background { skyColor [ 0.88 0.93 0.98 ] }
DirectionalLight { direction -0.3 0.4 -1 intensity 1.8 ambientIntensity 0.8 castShadows FALSE }
Solid {
  translation 0 0 -0.01
  children [ Shape { appearance PBRAppearance { baseColor 0.88 0.9 0.93 roughness 1 } geometry DEF STUDY_FLOOR Box { size 2 1.4 0.02 } } ]
  boundingObject USE STUDY_FLOOR
}
Robot {
  children [
    Solid {
      translation -0.25 0 0.30
      children [
        Transform { translation 0 0 -0.15 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.28 0.38 metalness 0.6 roughness 0.4 } geometry Box { size 0.11 0.09 0.30 } } ] }
        Transform { translation 0 0.03 0 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.28 0.40 roughness 0.4 } geometry Cylinder { radius 0.035 height 0.05 } } ] }
        DEF STUDY_BASELINE_JOINT HingeJoint {
          jointParameters HingeJointParameters { axis 0 -1 0 anchor 0 0 0 minStop -1.047197551196598 maxStop 1.047197551196598 dampingConstant 0.005 }
          device [ RotationalMotor { name "baseline_motor" maxTorque 1 } PositionSensor { name "baseline_sensor" } ]
          endPoint DEF STUDY_BASELINE_LINK Solid {
            children [
              Transform { translation 0.075 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.24 0.46 0.85 metalness 0.5 roughness 0.4 } geometry Box { size 0.180 0.008 0.030 } } ] }
              Transform { translation 0.150 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.95 0.65 0.14 metalness 0.4 roughness 0.4 } geometry Box { size 0.015 0.015 0.015 } } ] }
            ]
            name "study_baseline_link"
            boundingObject Group { children [ Transform { translation 0.075 0 0 children [ Box { size 0.180 0.008 0.030 } ] } Transform { translation 0.150 0 0 children [ Box { size 0.015 0.015 0.015 } ] } ] }
            # Replaced from validated study_bodies.csv before running/reset.
            physics Physics { density -1 mass 0.36664 centerOfMass [ 0.126139 0 0 ] inertiaMatrix [ 0.00005 0.0010 0.0010 0 0 0 ] }
          }
        }
      ]
      name "baseline_fixed_support"
    }
    Solid {
      translation 0.25 0 0.30
      children [
        Transform { translation 0 0 -0.15 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.28 0.38 metalness 0.6 roughness 0.4 } geometry Box { size 0.11 0.09 0.30 } } ] }
        Transform { translation 0 0.03 0 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.28 0.40 roughness 0.4 } geometry Cylinder { radius 0.035 height 0.05 } } ] }
        # Fixed housing is visual only; contact geometry is deliberately deferred.
        Transform { translation 0.047 -0.025 0 children [ Shape { appearance PBRAppearance { baseColor 0.35 0.38 0.43 metalness 0.7 roughness 0.4 } geometry Box { size 0.035 0.015 0.045 } } ] }
        DEF STUDY_CANDIDATE_JOINT HingeJoint {
          jointParameters HingeJointParameters { axis 0 -1 0 anchor 0 0 0 minStop -1.047197551196598 maxStop 1.047197551196598 dampingConstant 0.005 }
          device [ RotationalMotor { name "candidate_motor" maxTorque 1 } PositionSensor { name "candidate_sensor" } ]
          endPoint DEF STUDY_CANDIDATE_LINK Solid {
            children [
              Transform { translation 0.075 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.68 0.45 metalness 0.5 roughness 0.4 } geometry Box { size 0.180 0.008 0.030 } } ] }
              Transform { translation 0.150 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.95 0.65 0.14 metalness 0.4 roughness 0.4 } geometry Box { size 0.015 0.015 0.015 } } ] }
              # Same Fourier contour as the energy/mass generator; no roller contact solver.
              Transform { translation 0 -0.012 0 children [ Shape { appearance PBRAppearance { baseColor 0.94 0.60 0.17 metalness 0.5 roughness 0.4 } geometry StudyCamGeometry {} } ] }
            ]
            name "study_candidate_link"
            boundingObject Group { children [ Transform { translation 0.075 0 0 children [ Box { size 0.180 0.008 0.030 } ] } Transform { translation 0.150 0 0 children [ Box { size 0.015 0.015 0.015 } ] } ] }
            physics Physics { density -1 mass 0.39315 centerOfMass [ 0.11762 -0.001 0 ] inertiaMatrix [ 0.00006 0.0012 0.0012 0 0 0 ] }
          }
        }
      ]
      name "candidate_fixed_support"
    }
  ]
  name "joint_study"
  controller "<extern>"
  supervisor TRUE
}
