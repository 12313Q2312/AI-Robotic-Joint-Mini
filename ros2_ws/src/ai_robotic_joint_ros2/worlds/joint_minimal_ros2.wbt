          appearance PBRAppearance { baseColor 0.65 0.65 0.68 roughness 0.45 metalness 0.7 }
          geometry Cylinder { height 0.035 radius 0.045 }
        }
      ]
    }
    Transform {
      translation 0 0 0.052
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 0.5 }
          geometry Cylinder { height 0.025 radius 0.018 }
        }
      ]
    }
    DEF JOINT_AXIS HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0.02
        minStop -1.5708
        maxStop 1.5708
        dampingConstant 0.02
      }
      device [
        RotationalMotor {
          name "joint_motor"
