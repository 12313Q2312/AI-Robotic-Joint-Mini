                geometry Box { size 0.05 0.05 0.06 }
              }
            ]
          }
        ]
        name "output_link"
        boundingObject Group {
          children [
            Shape { geometry USE LINK_GEOMETRY }
            Transform {
              translation 0.105 0 0
              children [Box { size 0.05 0.05 0.06 }]
