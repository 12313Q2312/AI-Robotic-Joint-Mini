<?xml version="1.0"?>
<package format="3">
  <name>ai_robotic_joint_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 command and state interface for AI Robotic Joint Mini.</description>
  <maintainer email="285632820+12313Q2312@users.noreply.github.com">12313Q2312</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
